# Copy to .env.local and fill in real values. Never commit .env.local.
# These power local dev + `npm run refresh:local`. The scheduled refresh reads
# the same keys from GitHub Actions secrets (except CRON_SECRET, which only
# guards the manual /api/refresh route).

# Tavily API key — crawls the news sources (https://tavily.com)
TAVILY_API_KEY=

# Nebius API key — LLM synthesis (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Upstash Redis REST credentials — auto-wired by Vercel Marketplace in prod
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret guarding /api/refresh (e.g. `openssl rand -hex 32`)
CRON_SECRET=

# Optional — overrides the primary Nebius model (default: Qwen/Qwen3-235B-A22B-Instruct-2507).
# The fallback models in lib/nebius.ts (MODEL_CHAIN) still apply after it.
# NEBIUS_MODEL=
